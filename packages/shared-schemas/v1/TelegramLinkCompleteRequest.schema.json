{
  "$id": "https://vanik.invalid/schemas/v1/TelegramLinkCompleteRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "link_code": {
      "format": "password",
      "maxLength": 64,
      "minLength": 20,
      "title": "Link Code",
      "type": "string",
      "writeOnly": true
    },
    "telegram_user_id": {
      "pattern": "^[1-9][0-9]{0,19}$",
      "title": "Telegram User Id",
      "type": "string"
    }
  },
  "required": [
    "link_code",
    "telegram_user_id"
  ],
  "title": "TelegramLinkCompleteRequest",
  "type": "object"
}
