{
  "$defs": {
    "BusinessRole": {
      "enum": [
        "buyer",
        "seller"
      ],
      "title": "BusinessRole",
      "type": "string"
    }
  },
  "$id": "https://vanik.invalid/schemas/v1/PrincipalCreateRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "address": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Address",
      "type": "string"
    },
    "business_type": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Business Type",
      "type": "string"
    },
    "contact_email": {
      "format": "email",
      "title": "Contact Email",
      "type": "string"
    },
    "legal_name": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Legal Name",
      "type": "string"
    },
    "roles": {
      "items": {
        "$ref": "#/$defs/BusinessRole"
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Roles",
      "type": "array",
      "uniqueItems": true
    },
    "trade_name": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Trade Name",
      "type": "string"
    }
  },
  "required": [
    "legal_name",
    "trade_name",
    "business_type",
    "address",
    "contact_email",
    "roles"
  ],
  "title": "PrincipalCreateRequest",
  "type": "object"
}
