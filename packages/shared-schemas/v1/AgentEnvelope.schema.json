{
  "$id": "https://vanik.invalid/schemas/v1/AgentEnvelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "key_version": {
      "minimum": 1,
      "title": "Key Version",
      "type": "integer"
    },
    "message_id": {
      "format": "uuid",
      "title": "Message Id",
      "type": "string"
    },
    "message_type": {
      "enum": [
        "REQUEST_FOR_QUOTE",
        "OFFER",
        "COUNTER_OFFER",
        "ACCEPT",
        "REJECT",
        "WITHDRAW",
        "FINAL_OFFER",
        "EXPIRE",
        "SECURITY_REPORT"
      ],
      "title": "Message Type",
      "type": "string"
    },
    "negotiation_id": {
      "format": "uuid",
      "title": "Negotiation Id",
      "type": "string"
    },
    "nonce": {
      "maxLength": 64,
      "minLength": 20,
      "title": "Nonce",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "payload_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Payload Hash",
      "type": "string"
    },
    "protocol_version": {
      "const": "vanik.a2a.v1",
      "default": "vanik.a2a.v1",
      "title": "Protocol Version",
      "type": "string"
    },
    "recipient_agent_id": {
      "format": "uuid",
      "title": "Recipient Agent Id",
      "type": "string"
    },
    "sender_agent_id": {
      "format": "uuid",
      "title": "Sender Agent Id",
      "type": "string"
    },
    "sender_principal_id": {
      "format": "uuid",
      "title": "Sender Principal Id",
      "type": "string"
    },
    "signature": {
      "title": "Signature",
      "type": "string"
    },
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "message_id",
    "message_type",
    "sender_agent_id",
    "recipient_agent_id",
    "sender_principal_id",
    "negotiation_id",
    "task_id",
    "created_at",
    "nonce",
    "key_version",
    "payload",
    "payload_hash",
    "signature"
  ],
  "title": "AgentEnvelope",
  "type": "object"
}
