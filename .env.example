# API
APP_ENV=development
APP_SECRET_KEY=replace-me
DATABASE_URL=postgresql+psycopg://vanik:vanik@localhost:5432/vanik
DATABASE_CONNECT_TIMEOUT=5
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
REDIS_URL=redis://localhost:6379/0

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Telegram (leave blank for bot-disabled local development)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# LLM provider (optional; deterministic demo fallback should work without it)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Signing key encryption secret; never commit real secrets
AGENT_KEY_ENCRYPTION_SECRET=replace-me

# Explicitly simulated integrations
MOCK_UPI_ENABLED=true
DEMO_VERIFICATION_ENABLED=true
DEMO_DATASET=diwali_kirana_v1
